# Copy to server/.env and fill in. NEVER commit .env or put these values in index.html.
PORT=8080

# Razorpay Dashboard -> Account & Settings -> API Keys. Use Test Mode keys (rzp_test_...) first.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay Dashboard -> Webhooks. URL: https://YOUR-DOMAIN/api/webhooks/razorpay
# Events: payment.captured, payment.failed, order.paid. Paste the secret you set there.
RAZORPAY_WEBHOOK_SECRET=

# Limits in rupees, enforced here AND shown in the page (the page reads them from /api/config)
MIN_AMOUNT_INR=10
MAX_AMOUNT_INR=100000

# Only if the static site is hosted on a DIFFERENT origin than this server, e.g. https://aquanexus.example.org
# (also set apiBase in the AQN_DONATE_CONFIG block of index.html)
ALLOWED_ORIGIN=

# Set to true only when running behind a reverse proxy you control (so rate limiting sees the real client IP)
TRUST_PROXY=false

# Where donation records are stored (JSON file, kept private to this server)
# DATA_FILE=./data/donations.json
# Set to "off" to stop this server serving ../index.html
# SITE_FILE=off
